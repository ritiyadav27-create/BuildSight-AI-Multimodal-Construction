# Get a Google Gemini API key from https://aistudio.google.com/apikey
# Never commit a real API key. Set this in Render Environment after deployment.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Only for split Vite + FastAPI deployment; single-service Docker requires no CORS changes.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional local history file path; SQLite data on ephemeral cloud containers is not durable.
# HISTORY_DB_PATH=./storage/history.sqlite3
